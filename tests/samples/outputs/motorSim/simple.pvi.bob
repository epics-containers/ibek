<display version="2.0.0">
  <name>Simple Device</name>
  <x>0</x>
  <y use_class="true">0</y>
  <width>438</width>
  <height>55</height>
  <background_color>
    <color red="245" green="247" blue="250">
    </color>
  </background_color>
  <grid_step_x>4</grid_step_x>
  <grid_step_y>4</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <class>TITLE</class>
    <text>Simple Device</text>
    <x use_class="true">0</x>
    <y use_class="true">0</y>
    <width>438</width>
    <height>25</height>
    <font use_class="true">
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <transparent use_class="true">true</transparent>
    <horizontal_alignment>1</horizontal_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Label</name>
    <text>Simple PV</text>
    <x>23</x>
    <y>30</y>
    <width>200</width>
    <height>20</height>
    <font>
      <font family="Cantarell" style="REGULAR" size="14.0">
      </font>
    </font>
    <tooltip>Simple PV - No description provided</tooltip>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>TextUpdate</name>
    <pv_name>$(P)Simple</pv_name>
    <x>228</x>
    <y>30</y>
    <width>205</width>
    <height>20</height>
    <font>
      <font family="Cantarell" style="BOLD" size="14.0">
      </font>
    </font>
    <foreground_color>
      <color red="15" green="23" blue="42">
      </color>
    </foreground_color>
    <background_color>
      <color red="245" green="247" blue="250">
      </color>
    </background_color>
    <horizontal_alignment>1</horizontal_alignment>
    <border_color>
      <color red="203" green="213" blue="225">
      </color>
    </border_color>
  </widget>
</display>
